{
  "name": "addplusimmigration",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "addplus-inquiries",
      "database_id": "be0e76d1-56e4-4662-8f6f-ee3be7861f24"
    }
  ]
}